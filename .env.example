BACKEND_PORT=8080
FRONTEND_PORT=3000
FRONTEND_PATH=../../frontend/senior-project-smart-ai-admin-panel
VITE_API_BASE_URL=/
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_university_db
POSTGRES_USER=smartrsu
POSTGRES_PASSWORD=replace-with-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=smartrsu
REDIS_PASSWORD=replace-with-local-password
REDIS_DATABASE=0
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=smart-university-auth
JWT_AUDIENCE=smart-university-backend
JWT_KEY_ID=auth-key-1
JWT_ACCESS_TOKEN_TTL=15m
JWT_CLOCK_SKEW=30s
AUTH_REDIS_KEY_PREFIX=susa:dev:auth
AUTH_REFRESH_TTL=7d
AUTH_PASSWORD_CHANGE_TTL=10m
AUTH_MAX_ROTATIONS=2000
BCRYPT_STRENGTH=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=15m
CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
AUTH_LOGIN_PER_IP=60
AUTH_LOGIN_PER_IDENTIFIER=10
AUTH_REFRESH_PER_IP=120
# Cloud LLM for the student assistant (OpenAI-compatible Chat Completions API).
# Example for Google Gemini: AI_PROVIDER=gemini, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-3.5-flash
# Put the real key only in your local .env (git-ignored); never commit it.
AI_PROVIDER=openai-compatible
AI_API_KEY=replace-with-your-api-key
AI_MODEL=replace-with-model-name
AI_BASE_URL=https://provider-api-endpoint/v1
AI_TIMEOUT_SECONDS=30
# Limits on academic tool calls within one assistant chat request.
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS=8
# Wall-clock bound for one whole chat request, including every Gemini call and tool run (>= AI_TIMEOUT_SECONDS).
AI_MAX_REQUEST_SECONDS=120
# Step 10 conversation context (Redis). A conversation expires AI_CONTEXT_TTL_MINUTES after its last completed turn;
# set it to 1 locally to try expiry. AI_CONTEXT_MAX_TURNS question/answer pairs are kept and sent to the model.
AI_CONTEXT_ENABLED=true
AI_CONTEXT_TTL_MINUTES=30
AI_CONTEXT_MAX_TURNS=6
AI_CONTEXT_MAX_COURSE_REFERENCES=20
AI_CONTEXT_MAX_BYTES=32768
# Step 17 conversation history (PostgreSQL). Every completed turn is stored until the Student deletes the conversation,
# and an expired Redis context is restored from it. false: Redis only, as in Step 10.
AI_HISTORY_ENABLED=true
# Step 15A: the assistant searches the AI Knowledge Base (needs AI_EMBEDDING_MODEL). With it on, a question about
# university rules is answered only from READY documents; turn it on when those documents are uploaded.
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_TOP_K=4
AI_KNOWLEDGE_MAX_CONTEXT_CHARS=8000
AI_KNOWLEDGE_MAX_SEARCHES_PER_REQUEST=2
# Step 15B: places of one search kept for the Student's own program (0 = off), and neighbouring chunks of a split
# section that one search may add (0 = off).
AI_KNOWLEDGE_OWN_PROGRAM_QUOTA=2
AI_KNOWLEDGE_MAX_NEIGHBOR_PASSAGES=2
# Step 16A: the assistant may read the Student's GPA, earned credits and current load (null until grading data exists).
AI_ACADEMIC_PROGRESS_ENABLED=true
# Step 16B: "How many credits do I still need to graduate?" combines that progress with the documents (needs both).
AI_HYBRID_ANSWERS_ENABLED=true
# Step 9 live evaluation (test only, never read by the application). Run with:
#   AI_EVAL_ENABLED=true ./mvnw test -Dtest=GeminiLiveIntentEvaluationTests
# AI_EVAL_ENABLED must be set in the shell; the other values may also live here.
AI_EVAL_MAX_CASES=20
AI_EVAL_REPEAT_COUNT=1
AI_EVAL_SPLIT=DEV
AI_EVAL_MAX_PROVIDER_CALLS=20
AI_EVAL_DELAY_SECONDS=15
AI_EVAL_OUTPUT_DIR=target/step09-evaluation

# Step 13 knowledge document storage (Docker always uses /app/storage/academic-documents on a named volume).
# Outside Docker the default root is ~/smart-university-storage/academic-documents.
KNOWLEDGE_STORAGE_TYPE=local
# KNOWLEDGE_STORAGE_ROOT=/absolute/path/outside/the/project
KNOWLEDGE_MAX_FILE_SIZE_MB=50
KNOWLEDGE_UPLOAD_ENABLED=true
KNOWLEDGE_STORAGE_DELETE_ORPHANS=false

# Step 14B knowledge ingestion worker (spec file 46).
# false turns ingestion off: nothing is queued or processed and reprocess answers 503.
KNOWLEDGE_INGESTION_ENABLED=true
# false creates no background poller (tests drive the worker themselves).
KNOWLEDGE_INGESTION_SCHEDULER_ENABLED=true
# Queue UPLOADED documents automatically once the pipeline is complete; set false to process documents one by one with reprocess.
KNOWLEDGE_INGESTION_AUTO_QUEUE=true
# Delay between two worker ticks (1s to 5m).
KNOWLEDGE_INGESTION_POLL_INTERVAL=5s
# Runs of one job before automatic retry stops (1 to 10).
KNOWLEDGE_INGESTION_MAX_ATTEMPTS=4
# Delay before automatic retry n is INITIAL_DELAY x MULTIPLIER^(n-1), capped at MAX_DELAY (defaults: 2m, 10m, 50m).
KNOWLEDGE_INGESTION_RETRY_INITIAL_DELAY=2m
KNOWLEDGE_INGESTION_RETRY_MULTIPLIER=5
KNOWLEDGE_INGESTION_RETRY_MAX_DELAY=6h
# A running job without a heartbeat for this long is treated as interrupted and retried.
KNOWLEDGE_INGESTION_STALE_AFTER=15m
# Wall-clock limit of one processing stage.
KNOWLEDGE_INGESTION_STAGE_TIMEOUT=30m

# Step 14C text extraction (spec file 47). Characters are Java chars.
# Maximum PDF pages, DOCX sections, sheets or text blocks of one file (1 to 10000).
KNOWLEDGE_EXTRACTION_MAX_PAGES=2000
# Maximum extracted characters of one file (10000 to 50000000).
KNOWLEDGE_EXTRACTION_MAX_CHARS=5000000
# A DOCX section, sheet or text block longer than this is stored as several rows (2000 to 200000).
KNOWLEDGE_EXTRACTION_UNIT_MAX_CHARS=20000
# Wall-clock limit for parsing one file (10s to 30m, shorter than KNOWLEDGE_INGESTION_STAGE_TIMEOUT).
KNOWLEDGE_EXTRACTION_TIMEOUT=5m
# true orders PDF text by position (keeps table rows together); false keeps stream order (better for multi-column pages).
KNOWLEDGE_EXTRACTION_PDF_SORT_BY_POSITION=true
# Directory for the private working copy; empty means <java.io.tmpdir>/knowledge-extraction.
KNOWLEDGE_EXTRACTION_TEMP_DIR=

# Step 14D text cleaning (spec file 48). After changing any of these, reprocess every document with mode FULL.
# Join the hard-wrapped lines of PDF pages into paragraphs.
KNOWLEDGE_CLEANING_UNWRAP_LINES=true
# Remove headers and footers that repeat across PDF pages.
KNOWLEDGE_CLEANING_REMOVE_REPEATED_LINES=true
# Write Thai digits as 0-9 (also applied to search questions; keep it the same for both).
KNOWLEDGE_CLEANING_THAI_DIGITS_TO_ASCII=true

# Step 14E chunking (spec file 49), in characters. Must satisfy MIN + TARGET + OVERLAP <= MAX.
# After a change, existing documents keep their chunks until reprocessed with mode FULL.
KNOWLEDGE_CHUNK_TARGET_CHARS=1000
KNOWLEDGE_CHUNK_MAX_CHARS=1500
KNOWLEDGE_CHUNK_MIN_CHARS=200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
# Maximum number of chunks of one file.
KNOWLEDGE_CHUNK_MAX_CHUNKS=5000

# Step 14F embeddings. Empty AI_EMBEDDING_BASE_URL / AI_EMBEDDING_API_KEY reuse AI_BASE_URL / AI_API_KEY.
# Example for Google Gemini: AI_EMBEDDING_MODEL=gemini-embedding-001
# From this step on, the text of every uploaded knowledge document is sent to the embedding provider chunk by chunk.
AI_EMBEDDING_MODEL=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
# Must be 768 (the vector(768) column).
AI_EMBEDDING_DIMENSIONS=768
# Set false for a provider that rejects the dimensions field and already returns 768 numbers.
AI_EMBEDDING_SEND_DIMENSIONS=true
# Cut a longer vector (e.g. gemini-embedding-001's default 3072) to its first 768 numbers and re-normalize it.
# Only correct for Matryoshka models (gemini-embedding-001, text-embedding-3-*); set false for other models.
AI_EMBEDDING_TRUNCATE_LONGER_VECTORS=true
# Set 1 for a provider that does not accept an array as input.
AI_EMBEDDING_BATCH_SIZE=16
AI_EMBEDDING_MAX_BATCH_TOKENS=8000
AI_EMBEDDING_TIMEOUT_SECONDS=30
AI_EMBEDDING_QUERY_TIMEOUT_SECONDS=10
AI_EMBEDDING_MAX_RETRIES=2
# Minimum time between two document requests of the EMBED stage (free-tier rate limits).
AI_EMBEDDING_MIN_INTERVAL_MS=1000
# Opt-in live checks (test only, never read by the application; set in the shell, they call the real provider):
#   KNOWLEDGE_EVAL_ENABLED=true ./mvnw test -Dtest=LiveEmbeddingCheck

# Step 14H semantic search. MIN_SCORE is a starting value: calibrate it for the embedding model (spec file 52, section 18).
KNOWLEDGE_SEARCH_DEFAULT_TOP_K=5
KNOWLEDGE_SEARCH_MIN_SCORE=0.50
KNOWLEDGE_SEARCH_MAX_PER_DOCUMENT=3
KNOWLEDGE_SEARCH_HNSW_EF_SEARCH=100
# How long a query vector stays in Redis; 0 turns the cache off.
KNOWLEDGE_SEARCH_QUERY_CACHE_TTL=24h
# Opt-in live retrieval evaluation (test only; calls the real embedding provider):
#   KNOWLEDGE_EVAL_ENABLED=true ./mvnw test -Dtest=KnowledgeLiveRetrievalEvaluationTests
KNOWLEDGE_EVAL_MAX_REQUESTS=40

# Student mobile academic data: next class and "due today" use this zone. Deadline list bounds have defaults
# in application.properties (STUDENT_DEADLINE_DEFAULT_LIMIT, _MAX_LIMIT, _WINDOW_DAYS, _MAX_WINDOW_DAYS, STUDENT_HOME_DEADLINE_LIMIT).
UNIVERSITY_TIMEZONE=Asia/Bangkok

# Campus navigation estimates and bounds have defaults in application.properties
# (CAMPUS_WALKING_SPEED_MPS, CAMPUS_MAX_ORIGIN_SNAP_METERS, CAMPUS_LOWEST_FLOOR_NUMBER, CAMPUS_NEARBY_DEFAULT_LIMIT, CAMPUS_NEARBY_MAX_LIMIT).
